// Violet Spawn Script
// Spawns Violet in Candlekeep exterior (BG2600 in EET)
// One-time encounter: she appears, gives the whip, vanishes

IF
  Global("AAVioletSpawned","GLOBAL",0)
  Global("AAVioletMet","GLOBAL",0)
THEN
  RESPONSE #100
    SetGlobal("AAVioletSpawned","GLOBAL",1)
    CreateCreature("AAViolet",[3270.2780],4)
END
