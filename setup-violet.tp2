BACKUP ~violet/backup~
AUTHOR ~Aaron - violet-vector.com~
VERSION ~v1.0~

AUTO_TRA ~violet/translations/%s~
LANGUAGE ~English~ ~english~ ~violet/translations/english/setup.tra~

BEGIN @0 /* Violet -- Encounter from Beyond the Planes */
DESIGNATED 0
REQUIRE_PREDICATE GAME_IS ~bg2ee eet~ ~This mod requires BG2:EE or EET.~

// =============================================
// ITEMS
// =============================================
// Note: Monofilament Whip is now created by the aaitems mod (dagger-based).
// Violet's dialogue gives the player the whip via GiveItemCreate.
// No duplicate item creation needed here.

// --- Kerry's tech items (merged from standalone Kerry mod) ---
// Fix: patch icons to base game resources (originals were from mods no longer installed)
COPY ~violet/items/techring.ITM~ ~override~
  SAY NAME1 ~Tech Ring~
  SAY NAME2 ~Tech Ring~
  WRITE_ASCII 0x003A ~IRING06~ #8   // inventory icon (base game ring)
  WRITE_ASCII 0x0058 ~CRING06~ #8   // description icon

COPY ~violet/items/moonkat.ITM~ ~override~
  SAY NAME1 ~Moonblade Katana~
  SAY NAME2 ~Moonblade Katana~
  WRITE_ASCII 0x003A ~ISW1H44~ #8   // inventory icon (base game katana)
  WRITE_ASCII 0x0044 ~GSW1H01~ #8   // ground icon
  WRITE_ASCII 0x0058 ~CSW1H44~ #8   // description icon
  // Fix ability header icon too (offset 0x0076 = ability 0 icon)
  READ_LONG 0x0064 abil_off
  WRITE_ASCII (abil_off + 0x04) ~ISW1H44~ #8

COPY ~violet/items/moonbow.ITM~ ~override~
  SAY NAME1 ~Moonbow~
  SAY NAME2 ~Moonbow~
  WRITE_ASCII 0x003A ~IBOW05~ #8    // inventory icon (base game bow)
  WRITE_ASCII 0x0044 ~GBOW05~ #8    // ground icon
  WRITE_ASCII 0x0058 ~CBOW05~ #8    // description icon
  READ_LONG 0x0064 abil_off
  WRITE_ASCII (abil_off + 0x04) ~IBOW05~ #8

// =============================================
// CREATURE - Violet (AI projection -- non-joinable encounter)
// =============================================
// Base off aerie.cre (valid elf female model with complete CRE structure)
COPY_EXISTING ~aerie.cre~ ~override/aaviolet.cre~
  SAY NAME1 @1
  SAY NAME2 @2

  // Stats (mostly irrelevant since she is non-joinable, but set for flavor)
  WRITE_BYTE  0x0238 8   // STR
  WRITE_BYTE  0x0239 0   // STR bonus
  WRITE_BYTE  0x023a 20  // DEX
  WRITE_BYTE  0x023b 18  // CON
  WRITE_BYTE  0x023c 10  // INT
  WRITE_BYTE  0x023e 18  // WIS
  WRITE_BYTE  0x023f 16  // CHA

  // Animation: 0x7F3B (Deva) -- glowing angelic projection
  // Previous crash was from wrong color byte offsets, not the animation itself
  WRITE_LONG  0x0028 0x7F3B

  // Class: Cleric/Mage (14) -- divine+arcane, fits her nature
  WRITE_BYTE  0x0273 14

  // Race: Elf (2) -- Weave's interpretation
  WRITE_BYTE  0x0272 2

  // Gender: Female (2)
  WRITE_BYTE  0x0275 2

  // Alignment: Neutral Good (0x21)
  WRITE_BYTE  0x027b 0x21

  // Level: Cleric 6, Mage 6
  WRITE_BYTE  0x0234 6
  WRITE_BYTE  0x0235 6
  WRITE_BYTE  0x0236 0

  // HP
  WRITE_SHORT 0x0024 35
  WRITE_SHORT 0x0026 35

  // Death variable
  WRITE_ASCII 0x0280 ~AAViolet~ #32

  // Dialogue ref: points to encounter dialogue (non-join)
  WRITE_ASCII 0x02cc ~AAVioleJ~ #8

  // Override script -- simple dialogue initiation only
  WRITE_ASCII 0x0248 ~AAViolet~ #8

  // Portrait (still used for dialogue window)
  WRITE_ASCII 0x0034 ~AAVioLtS~ #8
  WRITE_ASCII 0x003c ~AAVioLtL~ #8

  // Colors: purple tones (CRE V1.0 correct offsets: 0x002C-0x0032)
  WRITE_BYTE  0x002C 47  // Metal color: purple
  WRITE_BYTE  0x002D 47  // Minor color: purple
  WRITE_BYTE  0x002E 47  // Major color: purple
  WRITE_BYTE  0x002F 16  // Skin color: pale
  WRITE_BYTE  0x0032 96  // Hair color: light purple

  // Remove ALL items inherited from base creature (Aerie's gear)
  REMOVE_CRE_ITEM ~staf01~
  REMOVE_CRE_ITEM ~shld01~
  REMOVE_CRE_ITEM ~potn08~
  REMOVE_CRE_ITEM ~ring01~
  REMOVE_CRE_ITEM ~helm01~
  REMOVE_CRE_ITEM ~clck01~
  REMOVE_CRE_ITEM ~brac01~
  REMOVE_CRE_ITEM ~boot01~
  REMOVE_CRE_ITEM ~misc01~
  REMOVE_CRE_ITEM ~dagg01~

  // No equipment -- she is an intangible projection, not a party member

// =============================================
// DIALOGUES
// =============================================
COMPILE ~violet/dialogues/aavioletj.d~   // Encounter dialogue (non-joinable)
COMPILE ~violet/dialogues/aavioletb.d~   // Interdimensional appearances (FAI, Iron Throne)

// =============================================
// SCRIPTS
// =============================================
COMPILE ~violet/scripts/aasignal.baf~    // Spawn script for Candlekeep
COMPILE ~violet/scripts/aaviolet.baf~    // Dialogue initiation only
COMPILE ~violet/scripts/aaviolb1.baf~    // Spawn at Friendly Arm Inn
COMPILE ~violet/scripts/aaviolb2.baf~    // Spawn at Iron Throne HQ

// Spawn Violet directly in Candlekeep exterior (BG2600 in EET)
EXTEND_BOTTOM ~BG2600.bcs~ ~violet/scripts/aasignal.baf~

// Spawn Violet at Friendly Arm Inn (after first meeting)
EXTEND_BOTTOM ~BG2300.bcs~ ~violet/scripts/aaviolb1.baf~

// Spawn Violet at Iron Throne HQ top floor (after FAI appearance)
EXTEND_BOTTOM ~BG0614.bcs~ ~violet/scripts/aaviolb2.baf~

// =============================================
// PORTRAITS - placeholder
// =============================================
COPY ~violet/portraits/aavioltl.bmp~ ~override/aavioltl.bmp~
COPY ~violet/portraits/aaviolts.bmp~ ~override/aaviolts.bmp~

PRINT ~
=====================================================
  VIOLET v1.0 installed.

  A glowing figure has appeared outside Candlekeep.
  She has a gift for you, and a message from
  somewhere that should not exist.

  Non-joinable encounter. She gives you the
  Monofilament Whip, Tech Ring, Moonblade Katana,
  and Moonbow, then vanishes.
=====================================================
~
